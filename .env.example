# =============================================================================
# NSE Stock Prediction & Quantitative Portfolio Platform — Environment Variables
# =============================================================================

# Flask Application Settings
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_hex_key
PORT=5000

# Database Configuration (Supports 'sqlite' or 'mysql')
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_predictions
DB_USER=stock_user
DB_PASSWORD=your_secure_db_password

# Redis Caching (Optional: set to 'false' to use fast in-memory dictionary caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Live Market Data API (Upstox API v2 - Optional; falls back to yfinance)
MARKET_DATA_ENABLED=true
STOCK_API_KEY=
STOCK_API_SECRET=
STOCK_ACCESS_TOKEN=
LIVE_DATA_CACHE_TTL=10

# Financial News API (Optional; falls back to Google News / Yahoo Finance RSS)
NEWS_API_KEY=

# Authentication & JWT Security
JWT_SECRET_KEY=change_this_to_another_secure_jwt_secret_key

# Email Alerts & Password Reset (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
