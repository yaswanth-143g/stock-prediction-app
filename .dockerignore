merge-csv.csv
Stock_Data/*.csv
!Stock_Data/RELIANCE.NS.csv
*.tmp
*.temp
/tmp/

# Logs and Runtime Artifacts
*.log
logs/*
!logs/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
