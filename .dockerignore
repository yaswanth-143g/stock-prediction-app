# Git and IDE
.git
.gitignore
.gitattributes
.idea
.vscode
*.sublime-project
*.sublime-workspace

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

